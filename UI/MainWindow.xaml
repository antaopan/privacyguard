<Window x:Class="PrivacyGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:PrivacyGuard"
        Title="隐私卫士 PrivacyGuard"
        Width="1240" Height="800" MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Icon="pack://application:,,,/Assets/app.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Closing="Window_Closing" StateChanged="Window_StateChanged" Loaded="Window_Loaded"
        SourceInitialized="Window_SourceInitialized">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolVis" />
        <local:StringNotEmptyToVisibilityConverter x:Key="StringVis" />
        <local:ZeroCountToVisibilityConverter x:Key="ZeroVis" />
        <local:BoolToOpacityConverter x:Key="BoolOpacity" />
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource BgBrush}" BorderBrush="#23344D" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="82" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="154" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="11" Background="#102A33" BorderBrush="#1E5A57"
                                    BorderThickness="1">
                                <TextBlock Text="&#xE83D;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="隐私卫士" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="PRIVACYGUARD" FontSize="8" Foreground="{StaticResource MutedBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="工作台" Style="{StaticResource SectionLabel}" Margin="24,0,0,7" />
                        <ToggleButton x:Name="NavOverview" Style="{StaticResource NavButton}" IsChecked="True" Tag="0"
                                      Click="Nav_Click" HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE80F;" Style="{StaticResource IconText}" FontSize="16" />
                                <TextBlock Grid.Column="1" Text="总览" VerticalAlignment="Center" FontSize="13" />
                            </Grid>
                        </ToggleButton>
                        <ToggleButton x:Name="NavApps" Style="{StaticResource NavButton}" Tag="1" Click="Nav_Click"
                                      HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE71D;" Style="{StaticResource IconText}" FontSize="16" />
                                <TextBlock Grid.Column="1" Text="应用黑名单" VerticalAlignment="Center" FontSize="13" />
                            </Grid>
                        </ToggleButton>
                        <ToggleButton x:Name="NavLauncher" Style="{StaticResource NavButton}" Tag="2" Click="Nav_Click"
                                      HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE768;" Style="{StaticResource IconText}" FontSize="16" />
                                <TextBlock Grid.Column="1" Text="隐私启动器" VerticalAlignment="Center" FontSize="13" />
                            </Grid>
                        </ToggleButton>

                        <TextBlock Text="防护配置" Style="{StaticResource SectionLabel}" Margin="24,18,0,7" />
                        <ToggleButton x:Name="NavHardening" Style="{StaticResource NavButton}" Tag="3" Click="Nav_Click"
                                      HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE72E;" Style="{StaticResource IconText}" FontSize="16" />
                                <TextBlock Grid.Column="1" Text="系统加固" VerticalAlignment="Center" FontSize="13" />
                            </Grid>
                        </ToggleButton>
                        <ToggleButton x:Name="NavLogs" Style="{StaticResource NavButton}" Tag="4" Click="Nav_Click"
                                      HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE81C;" Style="{StaticResource IconText}" FontSize="16" />
                                <TextBlock Grid.Column="1" Text="防护日志" VerticalAlignment="Center" FontSize="13" />
                            </Grid>
                        </ToggleButton>
                        <ToggleButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="5" Click="Nav_Click"
                                      HorizontalContentAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE713;" Style="{StaticResource IconText}" FontSize="16" />
                                <TextBlock Grid.Column="1" Text="设置" VerticalAlignment="Center" FontSize="13" />
                            </Grid>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="14,0,14,16">
                        <Border Background="#0D1B2C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7" Height="7" Fill="{Binding ServiceStateBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="后台服务" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding ServiceStateText}" FontSize="11"
                                               Foreground="{Binding ServiceStateBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding LastSyncText}" FontSize="10" Foreground="#5F7490" Margin="0,7,0,0" />
                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10,0,8" />
                                <TextBlock Text="v1.1.0 · Windows" FontSize="10" Foreground="#5F7490" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        Background="#091321" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="26,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding PageTitle}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#0D2427" BorderBrush="#1E4B48" BorderThickness="1" CornerRadius="7"
                                    Padding="9,5" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{Binding ServiceStateBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="服务 " FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ServiceStateText}" FontSize="10" Foreground="{Binding ServiceStateBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Button Content="&#x2014;" Style="{StaticResource WindowButton}" Click="Minimize_Click"
                                    ToolTip="最小化" />
                            <Button x:Name="MaxButton" Content="&#x25A1;" Style="{StaticResource WindowButton}"
                                    Click="Maximize_Click" ToolTip="最大化" />
                            <Button Content="&#x00D7;" Style="{StaticResource WindowCloseButton}" Click="Close_Click"
                                    ToolTip="关闭到托盘" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TabControl x:Name="Tabs" Grid.Row="1" Style="{StaticResource HiddenTabControl}" SelectedIndex="0">
                    <!-- Overview -->
                    <TabItem>
                        <ScrollViewer x:Name="DashboardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="26,22,26,28">
                                <Border Visibility="{Binding HasRisk, Converter={StaticResource BoolVis}}"
                                        Background="#241D0E" BorderBrush="#5B461A" BorderThickness="1" CornerRadius="10"
                                        Padding="13,10" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                   Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding RiskMessage}" Foreground="#E8C97A"
                                                   TextWrapping="Wrap" FontSize="12" Margin="10,0,12,0" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="去处理" Style="{StaticResource SmallButton}"
                                                Click="RiskAction_Click" />
                                    </Grid>
                                </Border>

                                <Border CornerRadius="18" Padding="26" Margin="0,0,0,16" BorderBrush="#1C3D4A"
                                        BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#10283D" Offset="0" />
                                            <GradientStop Color="#0E1C2D" Offset="0.56" />
                                            <GradientStop Color="#0B1A2A" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Style="{StaticResource BadgeBorder}" Background="#12312E">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="实时防护" FontSize="10" Foreground="{StaticResource AccentBrush}"
                                                                   Margin="6,0,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding AppliedAtText}"
                                                           FontSize="10" Foreground="#6E829B" Margin="10,0,0,0"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding StatusTitle}" FontSize="28" FontWeight="SemiBold"
                                                       Margin="0,16,0,5" />
                                            <TextBlock Text="{Binding StatusSubtitle}" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="12" TextWrapping="Wrap" MaxWidth="540" HorizontalAlignment="Left" />
                                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                                <Button Content="立即隔离" Style="{StaticResource PrimaryButton}"
                                                        Click="Panic_Click" />
                                                <Button Content="管理黑名单" Margin="10,0,0,0" Click="GoApps_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Width="178" Height="178" Stroke="#1B4950" StrokeThickness="1" />
                                            <Ellipse Width="138" Height="138" Stroke="#21605C" StrokeThickness="1" />
                                            <Ellipse Width="98" Height="98" Fill="#0C242B" Stroke="#2A6C66" StrokeThickness="1" />
                                            <TextBlock Text="&#xE83D;" FontFamily="{StaticResource IconFont}" FontSize="42"
                                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,0">
                                                <TextBlock Text="{Binding MasterStateText}" FontSize="10" Foreground="#7E93AA"
                                                           HorizontalAlignment="Center" />
                                                <ToggleButton x:Name="MasterToggle" Style="{StaticResource ToggleSwitch}"
                                                              Margin="0,6,0,0" Click="MasterToggle_Click"
                                                              HorizontalAlignment="Center" ToolTip="启用或暂停全部防护" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="黑名单应用" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                           Foreground="#3A526D" HorizontalAlignment="Right" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <TextBlock Text="{Binding AppCountText}" FontSize="27" FontWeight="SemiBold" />
                                                <TextBlock Text=" 个" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                           VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding EnabledAppCountText, StringFormat=已启用 {0} 个}" FontSize="10"
                                                       Foreground="#5F7490" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="网络规则" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="&#xE968;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                           Foreground="#3A526D" HorizontalAlignment="Right" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <TextBlock Text="{Binding RuleCount}" FontSize="27" FontWeight="SemiBold" />
                                                <TextBlock Text=" 条" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                           VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding FirewallStateText, StringFormat=防火墙 {0}}" FontSize="10"
                                                       Foreground="#5F7490" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="今日拦截" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                           Foreground="#3A526D" HorizontalAlignment="Right" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <TextBlock Text="{Binding BlockedToday}" FontSize="27" FontWeight="SemiBold" />
                                                <TextBlock Text=" 次" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                           VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding LastEvent}" FontSize="10" Foreground="#5F7490"
                                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource Card}" Padding="16">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="系统加固" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                           Foreground="#3A526D" HorizontalAlignment="Right" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <TextBlock Text="{Binding HardeningApplied}" FontSize="27" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding HardeningTotal, StringFormat= / {0}}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom"
                                                           Margin="0,0,0,4" />
                                            </StackPanel>
                                            <TextBlock Text="AI 数据采集防护" FontSize="10" Foreground="#5F7490" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.12*" />
                                        <ColumnDefinition Width="0.88*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="安全态势" Style="{StaticResource H2}" FontSize="15" />
                                                <Border Style="{StaticResource BadgeBorder}" HorizontalAlignment="Right">
                                                    <TextBlock Text="实时" FontSize="9" Foreground="{StaticResource AccentBrush}" />
                                                </Border>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Checklist}" Margin="0,16,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="30" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="26" Height="26" CornerRadius="7"
                                                                    Background="#10242F" BorderBrush="#1C3B47" BorderThickness="1">
                                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                                                           FontSize="12" Foreground="{Binding StateBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontSize="12" />
                                                                <TextBlock Text="{Binding Detail}" FontSize="10"
                                                                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="10"
                                                                       Foreground="{Binding StateBrush}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="最近事件" Style="{StaticResource H2}" FontSize="15" />
                                                <Button Content="全部日志" Style="{StaticResource GhostButton}" FontSize="10"
                                                        HorizontalAlignment="Right" Click="GoLogs_Click" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding RecentLogs}" Margin="0,16,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="12" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse Width="5" Height="5" Fill="#3D6270" VerticalAlignment="Top"
                                                                     Margin="0,5,0,0" />
                                                            <StackPanel Grid.Column="1" Margin="6,0,8,0">
                                                                <TextBlock Text="{Binding DisplayEvent}" FontSize="11"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Detail}" FontSize="10"
                                                                           Foreground="{StaticResource MutedBrush}"
                                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="9"
                                                                       Foreground="#5F7490" VerticalAlignment="Top" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="暂无事件" FontSize="11" Foreground="#5F7490"
                                                       Visibility="{Binding RecentLogs.Count, Converter={StaticResource ZeroVis}}"
                                                       Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Background="#0C1827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="14,11">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   Foreground="#6C849E" VerticalAlignment="Top" Margin="0,1,9,0" />
                                        <TextBlock Foreground="#7E93AA" FontSize="10.5" TextWrapping="Wrap" MaxWidth="900">
                                            防护边界：防火墙可阻断应用的网络出入口；UTC / en-US 与密钥剥离属于“兼容模式”指纹伪装，只对遵循标准环境变量的应用有效，并不等于内核级读取拦截。需要对抗性隔离时，请把 AI 应用放进独立 Windows 账户或虚拟机。
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Apps -->
                    <TabItem>
                        <Grid Margin="26,22,26,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="搜索" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="AppSearch" Width="240" Height="32" TextChanged="AppSearch_TextChanged" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="扫描 Claude / Gemini / Codex" Click="ScanApps_Click" Margin="0,0,8,0" />
                                    <Button Content="+  添加程序" Style="{StaticResource PrimaryButton}" Click="AddApp_Click" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Background="#0D1B2B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="9" Padding="12,9" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Margin="8,0,0,0" FontSize="10.5" Foreground="#8FA3BD" TextWrapping="Wrap">
                                        自动处理仅限 Claude / Gemini / Codex：首次启动会自动发现并纳入（默认“仅阻止入站 + 隐私启动器”）。其他应用不会被自动加入，请用“添加程序”手动添加。云端 AI 需要完整功能时不要选“完全断网”。
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="2">
                                <ListBox x:Name="AppsList" ItemsSource="{Binding Apps}" Background="Transparent"
                                         BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="12" Padding="13,11" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="34" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="34" Height="34" CornerRadius="9" Background="#0A1A2A"
                                                            BorderBrush="#1E354E" BorderThickness="1" VerticalAlignment="Center">
                                                        <Grid>
                                                            <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                                                       Foreground="#59738D" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            <Image Source="{Binding Icon}" Width="26" Height="26" />
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Border Background="#0E2A26" CornerRadius="5" Padding="6,2" Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding StatusText}" FontSize="9"
                                                                           Foreground="{Binding StatusBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding ShortPath}" FontSize="10" Foreground="#657B95"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                                                   ToolTip="{Binding Path}" />
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="2" Height="30" VerticalAlignment="Center"
                                                              SelectedValue="{Binding Network, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectedValuePath="Tag" SelectionChanged="RuleSetting_Changed"
                                                              ToolTip="{Binding NetworkHint}">
                                                        <ComboBoxItem Content="完全断网" Tag="full" />
                                                        <ComboBoxItem Content="仅阻止局域网" Tag="lan" />
                                                        <ComboBoxItem Content="仅阻止入站" Tag="inbound" />
                                                        <ComboBoxItem Content="不拦截" Tag="off" />
                                                    </ComboBox>
                                                    <ToggleButton Grid.Column="3" Style="{StaticResource IconToggle}"
                                                                  IsChecked="{Binding Shield, Mode=TwoWay}" Click="RuleSetting_Changed"
                                                                  ToolTip="使用隐私启动器启动（UTC / en-US / 密钥剥离）">
                                                        <TextBlock Text="&#xE83D;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                                    </ToggleButton>
                                                    <ToggleButton Grid.Column="4" Style="{StaticResource ToggleSwitch}"
                                                                  IsChecked="{Binding Enabled, Mode=TwoWay}" Click="RuleSetting_Changed"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  ToolTip="启用或停用此规则" />
                                                    <Button Grid.Column="5" Content="&#x00D7;" Style="{StaticResource GhostButton}"
                                                            FontFamily="Segoe UI" FontSize="15"
                                                            Foreground="#71859E" Click="DeleteApp_Click" Tag="{Binding}"
                                                            ToolTip="移除" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding HasApps, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                                    <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="42"
                                               Foreground="#2E435A" HorizontalAlignment="Center" />
                                    <TextBlock Text="还没有黑名单应用" FontSize="16" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,14,0,4" />
                                    <TextBlock Text="Claude、Gemini、Codex 会自动纳入；其他 AI 应用请手动添加程序。"
                                               FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                                               MaxWidth="440" TextWrapping="Wrap" TextAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                        <Button Content="添加程序" Style="{StaticResource PrimaryButton}" Click="AddApp_Click" />
                                        <Button Content="扫描已安装" Margin="8,0,0,0" Click="ScanApps_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Launcher -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid Margin="26,22,26,28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.08*" />
                                    <ColumnDefinition Width="0.92*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="启动设置" Style="{StaticResource H2}" FontSize="16" />
                                            <TextBlock Text="选择一个程序，隐私启动器会以标准用户权限、干净环境变量和伪装过的时区/语言启动它。"
                                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,18" />
                                            <TextBlock Text="目标应用" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="LaunchAppCombo" Height="34" ItemsSource="{Binding Apps}"
                                                          DisplayMemberPath="Name" SelectionChanged="LaunchApp_SelectionChanged" />
                                                <Button Grid.Column="1" Content="浏览程序" Margin="8,0,0,0" Click="BrowseLaunchApp_Click" />
                                            </Grid>
                                            <Grid Margin="0,16,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="时区（TZ）" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                                                    <TextBox x:Name="LaunchTimeZone" Height="32"
                                                             Text="{Binding Launcher.TimeZone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             TextChanged="LauncherSetting_Changed" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="语言 / Locale" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                                                    <TextBox x:Name="LaunchLanguage" Height="32"
                                                             Text="{Binding Launcher.Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             TextChanged="LauncherSetting_Changed" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="例如 UTC、Asia/Shanghai；语言例如 en-US、zh-CN。TZ 对 Node / Electron 系应用有效。"
                                                       FontSize="10" Foreground="#5F7490" Margin="0,7,0,0" TextWrapping="Wrap" />

                                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18,0,14" />
                                            <CheckBox Content="剥离常见 API Key / Token / 凭据环境变量" IsChecked="{Binding Launcher.StripSecrets, Mode=TwoWay}"
                                                      Click="LauncherSetting_Changed" Margin="0,0,0,11" />
                                            <CheckBox Content="使用中立的临时工作目录" IsChecked="{Binding Launcher.NeutralWorkingDir, Mode=TwoWay}"
                                                      Click="LauncherSetting_Changed" Margin="0,0,0,11" />
                                            <CheckBox Content="为 Chromium / Electron 附加 --lang 参数" IsChecked="{Binding Launcher.ChromiumLang, Mode=TwoWay}"
                                                      Click="LauncherSetting_Changed" Margin="0,0,0,11" />
                                            <Grid Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="伪装计算机名（可选）" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                                                    <TextBox Text="{Binding Launcher.FakeComputerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             TextChanged="LauncherSetting_Changed" Height="32" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="附加启动参数（可选）" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                                                    <TextBox Text="{Binding Launcher.ExtraArgs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             TextChanged="LauncherSetting_Changed" Height="32" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0" Background="#0D1A27">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                       Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,1,10,0" />
                                            <TextBlock Grid.Column="1" FontSize="10.5" Foreground="#9C8A5B" TextWrapping="Wrap">
                                                兼容模式不是安全边界：任意 Win32 程序仍可直接调用系统 API 读取时区、语言、本机 IP。要真正阻止读取，请使用独立 Windows 账户、Windows Sandbox 或虚拟机。这里的目标是降低“自动采集 + 云端上传”的成功率。
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Border Grid.Column="1" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="应用将看到" Style="{StaticResource H2}" FontSize="16" />
                                        <TextBlock Text="隐私启动器注入的环境变量" Style="{StaticResource MutedText}" Margin="0,5,0,16" />
                                        <Border Height="110" CornerRadius="12" Background="#0A1A28" BorderBrush="#1A3744"
                                                BorderThickness="1" Margin="0,0,0,16">
                                            <Grid>
                                                <Ellipse Width="82" Height="82" Stroke="#1B4A4F" StrokeThickness="1" />
                                                <TextBlock Text="&#xE83D;" FontFamily="{StaticResource IconFont}" FontSize="32"
                                                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding LauncherPreview}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="128" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Key}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="10.5"
                                                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Value}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10,0,14" />
                                        <Button x:Name="LaunchButton" Content="以隐私模式启动" Style="{StaticResource PrimaryButton}"
                                                Height="38" Click="LaunchShield_Click" />
                                        <Button Content="运行环境自检" Style="{StaticResource GhostButton}" Height="30"
                                                Margin="0,5,0,0" Click="VerifyEnvironment_Click"
                                                ToolTip="验证 TZ 时区修改、LANG 注入与系统语言读取结果" />
                                        <TextBlock Text="{Binding ShieldSummary}" FontSize="10" Foreground="#5F7490"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                                        <Border Background="#0A1826" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="9" Padding="12,10" Margin="0,18,0,0">
                                            <StackPanel>
                                                <TextBlock Text="高安全隔离建议" FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock FontSize="9.5" Foreground="#6F849C" TextWrapping="Wrap" Margin="0,4,0,0">
                                                    对真正高风险的 AI 桌面程序，最稳妥的方式是放进 Windows Sandbox / Hyper-V 虚拟机，并只映射必要文件夹。启动器解决的是“默认环境指纹与密钥泄漏”，不是对抗性沙箱。
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Hardening -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="26,22,26,28">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="AI 数据采集防护" Style="{StaticResource H2}" FontSize="18" />
                                            <TextBlock Text="通过本机策略关闭 Recall、Copilot、剪贴板云同步等系统级采集入口。所有改动均可恢复，暂停防护时会自动还原。"
                                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" MaxWidth="680"
                                                       HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="应用推荐配置" Style="{StaticResource PrimaryButton}" Click="ApplyRecommended_Click" />
                                            <TextBlock Text="{Binding HardeningApplied, StringFormat=服务已应用 {0} 项}" FontSize="10"
                                                       Foreground="#5F7490" HorizontalAlignment="Center" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Hardening}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="34" Height="34" CornerRadius="9" Background="#10242F"
                                                            BorderBrush="#1C3B47" BorderThickness="1" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding IconGlyph}" FontFamily="{StaticResource IconFont}"
                                                                   FontSize="15" Foreground="{StaticResource AccentBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,18,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" />
                                                            <Border Style="{StaticResource BadgeBorder}" Background="#12312E" Margin="8,0,0,0"
                                                                    Visibility="{Binding Recommended, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="推荐" FontSize="9" Foreground="{StaticResource AccentBrush}" />
                                                            </Border>
                                                            <Border Style="{StaticResource BadgeBorder}" Background="#1A2438" Margin="5,0,0,0"
                                                                    Visibility="{Binding NeedsSignOut, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="需重新登录" FontSize="9" Foreground="#8FA3BD" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                                                        <TextBlock Text="{Binding WarningText}" FontSize="9.5" Foreground="{StaticResource WarningBrush}"
                                                                   Margin="0,4,0,0"
                                                                   Visibility="{Binding WarningText, Converter={StaticResource StringVis}}" />
                                                    </StackPanel>
                                                    <ToggleButton Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}" Click="HardeningToggle_Click"
                                                                  VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Background="#0C1827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="14,11" Margin="0,4,0,0">
                                    <TextBlock Foreground="#7E93AA" FontSize="10.5" TextWrapping="Wrap">
                                        这些是 HKLM 计算机级策略，对当前机器上的所有用户生效，并在服务启动时自动重新应用。位置、摄像头/麦克风属于强隐私选项，默认关闭，避免影响地图与会议；开启后请留意相关功能。
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Logs -->
                    <TabItem>
                        <Grid Margin="26,22,26,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="LogFilter" Width="116" Height="32" SelectedIndex="0"
                                              SelectionChanged="LogFilter_Changed">
                                        <ComboBoxItem Content="全部" Tag="全部" />
                                        <ComboBoxItem Content="拦截" Tag="拦截" />
                                        <ComboBoxItem Content="警告" Tag="警告" />
                                        <ComboBoxItem Content="错误" Tag="错误" />
                                        <ComboBoxItem Content="信息" Tag="信息" />
                                    </ComboBox>
                                    <TextBox x:Name="LogSearch" Width="240" Height="32" Margin="8,0,0,0"
                                             TextChanged="LogSearch_Changed" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="刷新" Click="RefreshLogs_Click" Margin="0,0,8,0" />
                                    <Button Content="打开日志目录" Click="OpenLogDir_Click" Margin="0,0,8,0" />
                                    <Button Content="导出 CSV" Click="ExportLogs_Click" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Background="#0C1928" CornerRadius="12,12,0,0" Padding="14,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="66" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="时间" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="级别" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="来源" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="事件" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="详情" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Logs}" Padding="6"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingStackPanel.IsVirtualizing="True">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="8,6" ToolTip="{Binding Raw}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="104" />
                                                        <ColumnDefinition Width="58" />
                                                        <ColumnDefinition Width="66" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="#7B8FA7" />
                                                    <TextBlock Grid.Column="1" FontSize="9.5" Text="{Binding LevelText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#8FA3BD" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="BLOCK">
                                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="WARN">
                                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2" Text="{Binding Source}" FontSize="9.5" Foreground="#6A8098" />
                                                    <TextBlock Grid.Column="3" Text="{Binding DisplayEvent}" FontSize="10" Foreground="#B7C8DB"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Detail}" FontSize="10"
                                                               Foreground="#7B8FA7" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Visibility="{Binding Logs.Count, Converter={StaticResource ZeroVis}}">
                                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="34"
                                                   Foreground="#2E435A" HorizontalAlignment="Center" />
                                        <TextBlock Text="暂时没有符合条件的日志" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Settings -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="26,22,26,28">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="后台服务" Style="{StaticResource H2}" FontSize="16" />
                                                <TextBlock Text="服务以 LocalSystem 权限在开机时启动，独立于界面持续执行防火墙与系统策略。"
                                                           Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" Background="#0D2427" BorderBrush="#1E4B48"
                                                    BorderThickness="1" CornerRadius="7" Padding="10,5" VerticalAlignment="Top">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="{Binding ServiceStateBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ServiceStateText}" FontSize="10"
                                                               Foreground="{Binding ServiceStateBrush}" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="服务名" Style="{StaticResource SectionLabel}" />
                                                <TextBlock Text="PrivacyGuard" FontSize="12" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="启动方式" Style="{StaticResource SectionLabel}" />
                                                <TextBlock Text="自动（开机时）" FontSize="12" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="界面自启动" Style="{StaticResource SectionLabel}" />
                                                <TextBlock Text="登录时 · 计划任务" FontSize="12" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,14" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="安装 / 修复服务" Style="{StaticResource PrimaryButton}" Click="InstallService_Click" />
                                            <Button Content="启动" Margin="8,0,0,0" Click="StartService_Click" />
                                            <Button Content="停止" Margin="8,0,0,0" Click="StopService_Click" />
                                            <Button Content="立即重新应用" Margin="8,0,0,0" Click="Reapply_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="界面行为" Style="{StaticResource H2}" FontSize="16" />
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Ui.CloseToTray, Mode=TwoWay}"
                                                              Click="UiSetting_Click" VerticalAlignment="Center" />
                                                <StackPanel Margin="10,0,0,0">
                                                    <TextBlock Text="关闭时最小化到托盘" FontSize="11.5" />
                                                    <TextBlock Text="后台防护继续运行" FontSize="9.5" Foreground="#5F7490" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Ui.ClipboardGuard, Mode=TwoWay}"
                                                              Click="UiSetting_Click" VerticalAlignment="Center" />
                                                <StackPanel Margin="10,0,0,0">
                                                    <TextBlock Text="剪贴板密钥守卫" FontSize="11.5" />
                                                    <TextBlock Text="AI 应用在前台时清除疑似密钥" FontSize="9.5" Foreground="#5F7490" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Ui.NotifyOnBlock, Mode=TwoWay}"
                                                              Click="UiSetting_Click" VerticalAlignment="Center" />
                                                <StackPanel Margin="10,0,0,0">
                                                    <TextBlock Text="拦截通知" FontSize="11.5" />
                                                    <TextBlock Text="检测到黑名单进程时提醒" FontSize="9.5" Foreground="#5F7490" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="数据与维护" Style="{StaticResource H2}" FontSize="16" />
                                        <TextBlock Text="{Binding DataDir}" FontSize="10" Foreground="#5F7490" Margin="0,5,0,14"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="打开数据目录" Click="OpenDataDir_Click" />
                                            <Button Content="打开日志目录" Margin="8,0,0,0" Click="OpenLogDir_Click" />
                                            <Button Content="恢复系统隐私设置" Margin="8,0,0,0" Click="RestorePolicy_Click" />
                                            <Button Content="导出配置" Margin="8,0,0,0" Click="ExportConfig_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="关于 PrivacyGuard" Style="{StaticResource H2}" FontSize="16" />
                                            <TextBlock Text="本机 AI 隐私闸门 · 版本 1.1.0 · .NET Framework 4.8 · x64"
                                                       Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                                            <TextBlock Foreground="#667C95" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap"
                                                       MaxWidth="650" HorizontalAlignment="Left" TextAlignment="Left">
                                                防护不是“反病毒”：它不会阻止拥有管理员权限的恶意程序，也不提供内核级 API 拦截。源码可审计，所有系统改动均记录在数据目录。
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="卸载后台服务" Style="{StaticResource DangerButton}" Click="Uninstall_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

            <Border x:Name="ToastBorder" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,26,24" Background="#122A36" BorderBrush="#285B5C" BorderThickness="1" CornerRadius="10"
                    Padding="15,11" Visibility="Collapsed" Opacity="0" Panel.ZIndex="100">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ToastText" Foreground="{StaticResource TextBrush}" FontSize="11.5"
                               Margin="9,0,0,0" VerticalAlignment="Center" MaxWidth="440" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid x:Name="BusyOverlay" Grid.ColumnSpan="2" Background="#C408111F" Visibility="Collapsed" Panel.ZIndex="200">
                <Border Background="#101E31" BorderBrush="#26435A" BorderThickness="1" CornerRadius="12"
                        Padding="24,20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                    <StackPanel>
                        <TextBlock Text="&#xE83D;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding BusyText}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,14" />
                        <ProgressBar IsIndeterminate="True" Height="3" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

