<Window x:Class="PrivacyGuard.ScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扫描 AI 应用" Width="660" Height="640" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BgBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Background="{StaticResource BgBrush}" BorderBrush="#29415A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Background="#0A1523" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="扫描已安装的 AI 应用" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Content="&#x00D7;" Style="{StaticResource WindowCloseButton}" HorizontalAlignment="Right"
                            Click="Cancel_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,18,24,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="发现以下应用" Style="{StaticResource H2}" FontSize="15" />
                        <TextBlock Text="默认使用“整个安装目录 + 完全断网 + 隐私启动器”。添加后可以逐项调整。"
                                   Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="全选" Style="{StaticResource SmallButton}" Click="SelectAll_Click" Margin="0,0,6,0" />
                        <Button Content="全不选" Style="{StaticResource SmallButton}" Click="SelectNone_Click" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="8">
                    <ListBox x:Name="DetectedList" ItemsSource="{Binding Items}" Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="7,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Width="28" Height="28" CornerRadius="7" Background="#0A1A2A"
                                            BorderBrush="#1E354E" BorderThickness="1" VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                       Foreground="#59738D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Icon}" Width="22" Height="22" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                            <Border Background="#122A33" CornerRadius="5" Padding="5,1" Margin="7,0,0,0">
                                                <TextBlock Text="{Binding Source}" FontSize="8.5" Foreground="{StaticResource MutedBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ExePath}" FontSize="9.5" Foreground="#657B95"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding ExePath}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="#0A1523">
                <Grid Margin="24,0">
                    <TextBlock x:Name="CountText" Text="已选择 0 个" FontSize="10" Foreground="#5F7490"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0" />
                        <Button Content="添加选中" Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

