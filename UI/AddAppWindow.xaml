<Window x:Class="PrivacyGuard.AddAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加黑名单应用" Width="580" Height="570" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BgBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Background="{StaticResource BgBrush}" BorderBrush="#29415A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    Background="#0A1523" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="添加黑名单应用" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Content="&#x00D7;" Style="{StaticResource WindowCloseButton}" HorizontalAlignment="Right"
                            Click="Cancel_Click" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,18">
                    <TextBlock Text="程序路径" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" Height="34" TextChanged="PathBox_TextChanged" />
                        <Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0" Click="Browse_Click" />
                    </Grid>

                    <TextBlock Text="显示名称" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
                    <TextBox x:Name="NameBox" Height="34" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="拦截范围" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                            <ComboBox x:Name="ScopeCombo" Height="34" SelectedIndex="0">
                                <ComboBoxItem Content="仅此程序" Tag="file" />
                                <ComboBoxItem Content="整个安装目录（推荐 AI 应用）" Tag="folder" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="网络策略" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                            <ComboBox x:Name="NetworkCombo" Height="34" SelectedIndex="0">
                                <ComboBoxItem Content="完全断网（最严格）" Tag="full" />
                                <ComboBoxItem Content="仅阻止局域网" Tag="lan" />
                                <ComboBoxItem Content="仅阻止入站" Tag="inbound" />
                                <ComboBoxItem Content="不拦截" Tag="off" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Border Background="#0D1B2A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="14,12" Margin="0,18,0,0">
                        <StackPanel>
                            <CheckBox x:Name="ShieldCheck" Content="使用隐私启动器启动（UTC / en-US / 剥离密钥）"
                                      IsChecked="True" Margin="0,0,0,10" />
                            <CheckBox x:Name="KillCheck" Content="检测到该应用启动时立即终止进程（严格）" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="说明" Style="{StaticResource SectionLabel}" Margin="0,18,0,6" />
                    <TextBlock FontSize="10.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap">
                        选择“整个安装目录”会为该目录下的可执行文件创建规则，能覆盖 Claude 等应用的 Squirrel 版本目录。完全断网会让云端 AI 无法使用；仅阻止入站不会影响应用联网，但无法阻止云端收集。
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="#0A1523">
                <Grid Margin="24,0">
                    <TextBlock Text="路径必须是本机存在的 .exe 文件" FontSize="10" Foreground="#5F7490"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0" />
                        <Button Content="添加" Style="{StaticResource PrimaryButton}" Click="Ok_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

